{
  "$schema": "vscode://schemas/color-theme",
  "name": "Verdant Syntax Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#E1E8E4",
    "descriptionForeground": "#8FA097",
    "disabledForeground": "#69736D",
    "focusBorder": "#91AD9F",
    "contrastBorder": "#3A4540",
    "errorForeground": "#E06C75",
    "icon.foreground": "#AAB4AE",
    "selection.background": "#347A5055",
    "widget.border": "#3A4540",
    "widget.shadow": "#00000066",
    "input.background": "#171C19",
    "input.foreground": "#E1E8E4",
    "input.border": "#46524B",
    "input.placeholderForeground": "#78837C",
    "inputOption.activeBackground": "#2E664455",
    "inputOption.activeBorder": "#91AD9F",
    "dropdown.background": "#1B211D",
    "dropdown.border": "#46524B",
    "button.background": "#347A50",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#409460",
    "button.secondaryBackground": "#35413A",
    "badge.background": "#347A50",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#91AD9F",
    "editor.background": "#101714",
    "editor.foreground": "#F2F5F3",
    "editorLineNumber.foreground": "#5F6A63",
    "editorLineNumber.activeForeground": "#B8C2BC",
    "editorCursor.foreground": "#C1D3CA",
    "editor.selectionBackground": "#347A5066",
    "editor.inactiveSelectionBackground": "#347A5038",
    "editor.selectionHighlightBackground": "#55705F45",
    "editor.wordHighlightBackground": "#68756D35",
    "editor.wordHighlightStrongBackground": "#4FAE7345",
    "editor.findMatchBackground": "#A67C3D88",
    "editor.findMatchHighlightBackground": "#A67C3D44",
    "editor.lineHighlightBackground": "#18221E",
    "editor.lineHighlightBorder": "#2A3832",
    "editorWhitespace.foreground": "#39423D",
    "editorIndentGuide.background1": "#303934",
    "editorIndentGuide.activeBackground1": "#59665E",
    "editorBracketMatch.background": "#4FAE7325",
    "editorBracketMatch.border": "#91AD9F",
    "editorGutter.background": "#101714",
    "editorGutter.modifiedBackground": "#D0A85C",
    "editorGutter.addedBackground": "#58A875",
    "editorGutter.deletedBackground": "#D26870",
    "editorError.foreground": "#E06C75",
    "editorWarning.foreground": "#D5A95B",
    "editorInfo.foreground": "#62A8D8",
    "editorHint.foreground": "#77B993",
    "editorWidget.background": "#1B211D",
    "editorWidget.border": "#46524B",
    "editorHoverWidget.background": "#1B211D",
    "editorHoverWidget.border": "#46524B",
    "peekView.border": "#91AD9F",
    "peekViewEditor.background": "#171D19",
    "peekViewResult.background": "#1B211D",
    "peekViewResult.selectionBackground": "#2C5D404D",
    "activityBar.background": "#111512",
    "activityBar.foreground": "#E2E7E3",
    "activityBar.inactiveForeground": "#707B74",
    "activityBar.border": "#37413B",
    "activityBar.activeBorder": "#4FAE73",
    "activityBarBadge.background": "#4FAE73",
    "activityBarBadge.foreground": "#0E1711",
    "sideBar.background": "#181D1A",
    "sideBar.foreground": "#C4CBC6",
    "sideBar.border": "#37413B",
    "sideBarTitle.foreground": "#E0E5E1",
    "sideBarSectionHeader.background": "#202722",
    "sideBarSectionHeader.border": "#37413B",
    "list.activeSelectionBackground": "#294C37",
    "list.activeSelectionForeground": "#F1F5F2",
    "list.inactiveSelectionBackground": "#26332B",
    "list.hoverBackground": "#222A25",
    "list.focusOutline": "#91AD9F",
    "list.highlightForeground": "#B4C9BE",
    "tree.indentGuidesStroke": "#3B4640",
    "titleBar.activeBackground": "#20382F",
    "titleBar.activeForeground": "#D5DAD6",
    "titleBar.inactiveBackground": "#182A23",
    "titleBar.border": "#37413B",
    "menu.background": "#1B211D",
    "menu.foreground": "#D5DAD6",
    "menu.border": "#46524B",
    "menu.selectionBackground": "#294C37",
    "tab.activeBackground": "#101714",
    "tab.activeForeground": "#EEF2EF",
    "tab.activeBorderTop": "#91AD9F",
    "tab.activeBorder": "#101714",
    "tab.inactiveBackground": "#1C221E",
    "tab.inactiveForeground": "#89938D",
    "tab.border": "#37413B",
    "editorGroupHeader.tabsBackground": "#111512",
    "editorGroupHeader.tabsBorder": "#37413B",
    "editorGroup.border": "#46524B",
    "panel.background": "#171C19",
    "panel.border": "#46524B",
    "panelTitle.activeBorder": "#91AD9F",
    "panelTitle.activeForeground": "#E4E9E5",
    "panelTitle.inactiveForeground": "#87918B",
    "statusBar.background": "#20382F",
    "statusBar.foreground": "#F1F6F2",
    "statusBar.border": "#4C6655",
    "statusBar.noFolderBackground": "#20382F",
    "statusBar.debuggingBackground": "#8A5A35",
    "terminal.foreground": "#E1E8E4",
    "terminal.background": "#101714",
    "terminal.ansiGreen": "#91AD9F",
    "terminal.ansiBrightGreen": "#B4C9BE",
    "terminal.ansiBlue": "#67A8D8",
    "terminal.ansiYellow": "#D5A95B",
    "terminal.ansiRed": "#E06C75",
    "gitDecoration.addedResourceForeground": "#69B984",
    "gitDecoration.modifiedResourceForeground": "#D0A85C",
    "gitDecoration.deletedResourceForeground": "#D86F77",
    "gitDecoration.untrackedResourceForeground": "#69B984",
    "minimap.selectionHighlight": "#4FAE7377",
    "scrollbarSlider.background": "#64706855",
    "scrollbarSlider.hoverBackground": "#75817877",
    "scrollbarSlider.activeBackground": "#4FAE7399"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#71847A", "fontStyle": "italic" } },
    { "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.as"], "settings": { "foreground": "#A7C0B4" } },
    { "scope": ["meta.import punctuation", "meta.export punctuation", "meta.import-list punctuation", "meta.export-list punctuation"], "settings": { "foreground": "#8FA99C" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"], "settings": { "foreground": "#8DAD9E" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#DDD2AA" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"], "settings": { "foreground": "#A7C0B4" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#E1E9E5" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "support.class"], "settings": { "foreground": "#DDD2AA" } },
    { "scope": ["variable", "meta.definition.variable.name", "support.variable"], "settings": { "foreground": "#F2F5F3" } },
    { "scope": ["variable.parameter", "meta.parameters variable"], "settings": { "foreground": "#D3DDD8", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.other.constant"], "settings": { "foreground": "#DDD2AA" } },
    { "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#A7C0B4" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#B9CAC1" } },
    { "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#91A39A" } },
    { "scope": ["punctuation.definition.string", "punctuation.definition.template-expression"], "settings": { "foreground": "#8DAD9E" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#8FAD99", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#8FAD99", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#8FAD99", "fontStyle": "underline" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" } }
  ],
  "semanticTokenColors": {
    "namespace": "#CBBF98",
    "type": "#DDD2AA",
    "class": "#DDD2AA",
    "interface": "#DDD2AA",
    "enum": "#DDD2AA",
    "typeParameter": { "foreground": "#CBBF98", "italic": true },
    "function": "#E1E9E5",
    "method": "#E1E9E5",
    "parameter": { "foreground": "#D3DDD8", "italic": true },
    "property": "#E9EFEC",
    "enumMember": "#DDD2AA",
    "variable.readonly": "#CBBF98",
    "variable.defaultLibrary": "#A7C0B4",
    "decorator": "#B8C9C0"
  }
}
