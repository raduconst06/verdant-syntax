{
  "$schema": "vscode://schemas/color-theme",
  "name": "Verdant Syntax Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#29332D",
    "descriptionForeground": "#66736B",
    "disabledForeground": "#919B95",
    "focusBorder": "#15965A",
    "contrastBorder": "#B9C5BD",
    "errorForeground": "#B63E49",
    "icon.foreground": "#59675F",
    "selection.background": "#56A97844",
    "widget.border": "#B9C5BD",
    "widget.shadow": "#1D30221F",
    "input.background": "#DDDDDD",
    "input.foreground": "#29332D",
    "input.border": "#AAB8AF",
    "input.placeholderForeground": "#7B8880",
    "inputOption.activeBackground": "#BFE2CB88",
    "inputOption.activeBorder": "#278553",
    "dropdown.background": "#DDDDDD",
    "dropdown.border": "#AAB8AF",
    "button.background": "#287D50",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#216B45",
    "button.secondaryBackground": "#DCE5DF",
    "badge.background": "#287D50",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#278553",
    "editor.background": "#DDDDDD",
    "editor.foreground": "#24302B",
    "editorLineNumber.foreground": "#99A49D",
    "editorLineNumber.activeForeground": "#435048",
    "editorCursor.foreground": "#15965A",
    "editor.selectionBackground": "#4E806A70",
    "editor.inactiveSelectionBackground": "#6F948155",
    "editor.selectionHighlightBackground": "#7BA58A35",
    "editor.wordHighlightBackground": "#71807825",
    "editor.wordHighlightStrongBackground": "#27855335",
    "editor.findMatchBackground": "#E7B65488",
    "editor.findMatchHighlightBackground": "#E7B65455",
    "editor.lineHighlightBackground": "#D2D2D2",
    "editor.lineHighlightBorder": "#C4C4C4",
    "editorWhitespace.foreground": "#CCD5CF",
    "editorIndentGuide.background1": "#DDE5E0",
    "editorIndentGuide.activeBackground1": "#9EADA3",
    "editorBracketMatch.background": "#4DA77322",
    "editorBracketMatch.border": "#278553",
    "editorGutter.background": "#DDDDDD",
    "editorGutter.modifiedBackground": "#B27A20",
    "editorGutter.addedBackground": "#278553",
    "editorGutter.deletedBackground": "#B63E49",
    "editorError.foreground": "#B63E49",
    "editorWarning.foreground": "#A56B12",
    "editorInfo.foreground": "#2776A4",
    "editorHint.foreground": "#37815A",
    "editorWidget.background": "#DDDDDD",
    "editorWidget.border": "#AAB8AF",
    "editorHoverWidget.background": "#DDDDDD",
    "editorHoverWidget.border": "#AAB8AF",
    "peekView.border": "#278553",
    "peekViewEditor.background": "#DDDDDD",
    "peekViewResult.background": "#DDDDDD",
    "peekViewResult.selectionBackground": "#BFE2CB",
    "activityBar.background": "#DDDDDD",
    "activityBar.foreground": "#26332B",
    "activityBar.inactiveForeground": "#78857D",
    "activityBar.border": "#B9C5BD",
    "activityBar.activeBorder": "#278553",
    "activityBarBadge.background": "#278553",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#DDDDDD",
    "sideBar.foreground": "#344139",
    "sideBar.border": "#B9C5BD",
    "sideBarTitle.foreground": "#26332B",
    "sideBarSectionHeader.background": "#E7EDE9",
    "sideBarSectionHeader.border": "#B9C5BD",
    "list.activeSelectionBackground": "#4F725F",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#AABDB1",
    "list.inactiveSelectionForeground": "#1F2D26",
    "list.hoverBackground": "#BDC9C1",
    "list.focusOutline": "#278553",
    "list.highlightForeground": "#167344",
    "tree.indentGuidesStroke": "#B7C3BB",
    "titleBar.activeBackground": "#AABDB1",
    "titleBar.activeForeground": "#29332D",
    "titleBar.inactiveBackground": "#BCCAC2",
    "titleBar.border": "#B9C5BD",
    "menu.background": "#DDDDDD",
    "menu.foreground": "#29332D",
    "menu.border": "#AAB8AF",
    "menu.selectionBackground": "#C8E3D1",
    "tab.activeBackground": "#DDDDDD",
    "tab.activeForeground": "#1D2922",
    "tab.activeBorderTop": "#278553",
    "tab.activeBorder": "#DDDDDD",
    "tab.inactiveBackground": "#DDDDDD",
    "tab.inactiveForeground": "#66736B",
    "tab.border": "#B9C5BD",
    "editorGroupHeader.tabsBackground": "#DDDDDD",
    "editorGroupHeader.tabsBorder": "#B9C5BD",
    "editorGroup.border": "#AAB8AF",
    "panel.background": "#DDDDDD",
    "panel.border": "#AAB8AF",
    "panelTitle.activeBorder": "#278553",
    "panelTitle.activeForeground": "#253129",
    "panelTitle.inactiveForeground": "#6D7971",
    "statusBar.background": "#AABDB1",
    "statusBar.foreground": "#24302B",
    "statusBar.border": "#1E5739",
    "statusBar.noFolderBackground": "#AABDB1",
    "statusBar.debuggingBackground": "#9A5B27",
    "terminal.foreground": "#29332D",
    "terminal.background": "#DDDDDD",
    "terminal.ansiGreen": "#278553",
    "terminal.ansiBrightGreen": "#349B66",
    "terminal.ansiBlue": "#2776A4",
    "terminal.ansiYellow": "#A56B12",
    "terminal.ansiRed": "#B63E49",
    "gitDecoration.addedResourceForeground": "#278553",
    "gitDecoration.modifiedResourceForeground": "#A56B12",
    "gitDecoration.deletedResourceForeground": "#B63E49",
    "gitDecoration.untrackedResourceForeground": "#278553",
    "minimap.selectionHighlight": "#27855366",
    "scrollbarSlider.background": "#71807844",
    "scrollbarSlider.hoverBackground": "#71807866",
    "scrollbarSlider.activeBackground": "#27855388"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#708077", "fontStyle": "italic" } },
    { "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.as"], "settings": { "foreground": "#16824F" } },
    { "scope": ["meta.import punctuation", "meta.export punctuation", "meta.import-list punctuation", "meta.export-list punctuation"], "settings": { "foreground": "#329661" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"], "settings": { "foreground": "#2F7D4D" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#B87800" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"], "settings": { "foreground": "#16824F", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#263D30" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "support.class"], "settings": { "foreground": "#A66B00" } },
    { "scope": ["variable", "meta.definition.variable.name", "support.variable"], "settings": { "foreground": "#202722" } },
    { "scope": ["variable.parameter", "meta.parameters variable"], "settings": { "foreground": "#3D4942", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.other.constant"], "settings": { "foreground": "#B87800" } },
    { "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#16824F" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#4D6657" } },
    { "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#59655E" } },
    { "scope": ["punctuation.definition.string", "punctuation.definition.template-expression"], "settings": { "foreground": "#4D8060" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#16824F", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#202722", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#2F7D4D", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#16824F", "fontStyle": "underline" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FFFFFF", "background": "#A72F3B" } }
  ],
  "semanticTokenColors": {
    "namespace": "#B87800",
    "type": "#A66B00",
    "class": "#A66B00",
    "interface": "#A66B00",
    "enum": "#A66B00",
    "typeParameter": { "foreground": "#B87800", "italic": true },
    "function": "#263D30",
    "method": "#263D30",
    "parameter": { "foreground": "#3D4942", "italic": true },
    "property": "#34493C",
    "enumMember": "#B87800",
    "variable.readonly": "#B87800",
    "variable.defaultLibrary": "#16824F",
    "decorator": "#B87800"
  }
}
